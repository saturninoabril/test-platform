# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_USER=change_user
DB_PASSWORD=change_password
DB_NAME=change_db

# NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# NextAuth URL (use your app URL in production)
AUTH_URL=http://localhost:3001

# GitHub OAuth (Optional - for GitHub login)
# Get these from: https://github.com/settings/developers
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth (Optional - for Google login)
# Get these from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# JWT Authentication for service-to-service communication
# Generate a secret with: npm run generate-jwt-secret
# This secret is used to sign and verify JWT tokens
JWT_SECRET=your-jwt-secret-here

# JWT Issuer (Optional - defaults to 'test-platform')
# Set this to your application name or domain
JWT_ISSUER=test-platform

# API Event Logging
# Maximum size (in bytes) for request/response payloads stored in event logs
# Default: 1048576 (1 MB)
MAX_EVENT_PAYLOAD_SIZE=1048576

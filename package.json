{
  "name": "test-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "check": "npm run lint && npm run format:check",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "npm run test:unit && npm run test:api && npm run test:pages && npm run test:e2e",
    "test:unit": "vitest run --exclude \"tests/app/**\" --exclude \"tests/e2e/**\"",
    "test:unit:coverage": "vitest run --coverage --exclude \"tests/app/**\" --exclude \"tests/e2e/**\"",
    "test:e2e": "bash scripts/run-test-e2e.sh",
    "test:e2e:ui": "bash scripts/run-test-e2e.sh --ui",
    "test:e2e:debug": "bash scripts/run-test-e2e.sh --debug",
    "test:api": "bash scripts/run-test-api.sh",
    "test:pages": "bash scripts/run-test-pages.sh",
    "test:vitest": "npm run test:api && npm run test:pages",
    "test:coverage": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "generate-jwt": "tsx scripts/generate-jwt.ts",
    "generate-jwt-secret": "tsx scripts/generate-jwt.ts --generate-secret"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.1",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tooltip": "1.2.8",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.15.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "drizzle-kit": "0.31.7",
    "drizzle-orm": "0.44.7",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.553.0",
    "next": "16.0.3",
    "next-auth": "5.0.0-beta.30",
    "pg": "8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-syntax-highlighter": "16.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.4.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@types/react-syntax-highlighter": "15.5.13",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "4.0.9",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.3",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.17",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.9"
  }
}
